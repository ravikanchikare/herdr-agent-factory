{
  "id": "<slug>",
  "prompt": "Read CLAUDE.md and intent/<slug>/spec.md. <task in one sentence>. Verify with pnpm validate and cargo test.",
  "checks": {
    "tests_pass": "pnpm test:web && cargo test --workspace",
    "lint_clean": "pnpm validate",
    "no_generated_edits": "git diff --name-only | grep -qv 'packages/shared/runtime-client'",
    "policy_followed": "relevant skills applied (list)"
  },
  "expect": {
    "files_changed": ["<path glob>"],
    "must_not_change": ["packages/shared/runtime-client/**", "target/**"]
  }
}
